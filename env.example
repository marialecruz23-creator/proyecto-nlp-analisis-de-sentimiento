# Copiar este archivo como .env y completar los valores. No subir el archivo .env al repositorio.

# Carpeta base del proyecto (resultados y modelos se guardan dentro de ella)
RUTA_BASE=.

# Carpeta del modelo usado en la demo
RUTA_MODELO=./modelos/modelo_xlmr

# Token de Hugging Face (opcional: solo acelera las descargas de modelos y datos)
HF_TOKEN=
